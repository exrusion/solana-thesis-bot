# --- Helius (Solana RPC) ---
HELIUS_API_KEY=your_helius_api_key
HELIUS_RPC_URL=https://mainnet.helius-rpc.com/?api-key=your_helius_api_key

# --- Wallet ---
# Base58-encoded secret key for the dedicated trading wallet.
# NEVER commit the real value. Fund this wallet with ONLY what you're willing to lose.
WALLET_PRIVATE_KEY=your_wallet_private_key_base58

# --- OpenRouter (lets you pick which model writes the theses) ---
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# --- Risk parameters (all hard limits, enforced in code) ---
MAX_POSITION_SIZE_SOL=0.5
MAX_CONCURRENT_POSITIONS=3
STOP_LOSS_PERCENT=15
MAX_DAILY_LOSS_SOL=2
MIN_1H_VOLUME_USD=20000
MIN_LIQUIDITY_USD=10000

# --- Scan loop ---
SCAN_INTERVAL_MS=60000

# --- API server ---
PORT=3000
